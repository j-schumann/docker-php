{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "baseBranchPatterns": [
    "php8",
    "api-8",
    "symfony-8"
  ],
  "packageRules": [
    {
      "description": "Group the docker/* GitHub Actions, they are usually released together",
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["docker/**"],
      "groupName": "docker actions"
    }
  ],
  "customManagers": [
    {
      "description": "Pinned PECL extensions, e.g. `pecl install xdebug-3.5.1` (symfony-8)",
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)Dockerfile$/"],
      "matchStrings": ["pecl install xdebug-(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "xdebug/xdebug",
      "datasourceTemplate": "github-tags"
    },
    {
      "description": "Node.js major from the NodeSource setup script, e.g. `setup_24.x`; only LTS majors count as stable",
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)Dockerfile$/"],
      "matchStrings": ["deb\\.nodesource\\.com/setup_(?<currentValue>\\d+)\\.x"],
      "depNameTemplate": "node",
      "datasourceTemplate": "node-version",
      "versioningTemplate": "node"
    }
  ]
}
